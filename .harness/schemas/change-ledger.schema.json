{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/software-delivery-harness/1.0.0/change-ledger.schema.json",
  "title": "Software Delivery Harness change ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard_version", "change_ledger"],
  "properties": {
    "standard_version": {"const": "1.0.0"},
    "change_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_.-]*$"
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "idList": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "textList": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"},
      "uniqueItems": true
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id", "title", "description", "criticality", "category_path",
        "acceptance_criterion_ids", "test_case_ids", "normalized_sha256"
      ],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "criticality": {"enum": ["critical", "high", "medium", "low"]},
        "category_path": {"$ref": "#/$defs/idList"},
        "acceptance_criterion_ids": {"$ref": "#/$defs/idList"},
        "test_case_ids": {"$ref": "#/$defs/idList"},
        "normalized_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level", "requirements", "ui", "api", "database", "files",
        "permissions", "tests", "migration_required"
      ],
      "properties": {
        "risk_level": {"enum": ["critical", "high", "medium", "low"]},
        "requirements": {"$ref": "#/$defs/textList"},
        "ui": {"$ref": "#/$defs/textList"},
        "api": {"$ref": "#/$defs/textList"},
        "database": {"$ref": "#/$defs/textList"},
        "files": {"$ref": "#/$defs/textList"},
        "permissions": {"$ref": "#/$defs/textList"},
        "tests": {"$ref": "#/$defs/textList"},
        "migration_required": {"type": "boolean"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id", "requirement_ids", "change_type", "before", "after",
        "reason", "requested_by", "approved_by", "impact", "tests_to_update",
        "timestamp", "base_requirements_sha256", "result_requirements_sha256"
      ],
      "properties": {
        "change_id": {"$ref": "#/$defs/id"},
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "change_type": {
          "enum": [
            "add", "delete", "merge", "split", "rename", "scope_expand",
            "scope_reduce", "move", "reclassify", "acceptance_change",
            "contract_change", "criticality_change"
          ]
        },
        "before": {
          "type": "array",
          "items": {"$ref": "#/$defs/snapshot"}
        },
        "after": {
          "type": "array",
          "items": {"$ref": "#/$defs/snapshot"}
        },
        "reason": {"$ref": "#/$defs/text"},
        "requested_by": {"$ref": "#/$defs/text"},
        "approved_by": {"type": ["string", "null"], "maxLength": 256},
        "impact": {"$ref": "#/$defs/impact"},
        "tests_to_update": {"$ref": "#/$defs/idList"},
        "timestamp": {"type": "string", "format": "date-time"},
        "base_requirements_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_requirements_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"change_type": {"const": "add"}}, "required": ["change_type"]},
          "then": {
            "properties": {
              "before": {"maxItems": 0},
              "after": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"change_type": {"const": "delete"}}, "required": ["change_type"]},
          "then": {
            "properties": {
              "before": {"minItems": 1},
              "after": {"maxItems": 0},
              "approved_by": {"type": "string", "minLength": 1},
              "base_requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "result_requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        {
          "if": {"properties": {"change_type": {"const": "merge"}}, "required": ["change_type"]},
          "then": {
            "properties": {
              "before": {"minItems": 2},
              "after": {"minItems": 1, "maxItems": 1},
              "approved_by": {"type": "string", "minLength": 1},
              "base_requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "result_requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        {
          "if": {"properties": {"change_type": {"const": "split"}}, "required": ["change_type"]},
          "then": {
            "properties": {
              "before": {"minItems": 1, "maxItems": 1},
              "after": {"minItems": 2}
            }
          }
        },
        {
          "if": {
            "properties": {
              "change_type": {
                "enum": ["scope_reduce", "acceptance_change", "contract_change", "criticality_change"]
              }
            },
            "required": ["change_type"]
          },
          "then": {
            "properties": {
              "before": {"minItems": 1},
              "after": {"minItems": 1},
              "approved_by": {"type": "string", "minLength": 1},
              "base_requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "result_requirements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      ]
    }
  }
}
